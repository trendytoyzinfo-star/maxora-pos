#!/bin/sh
set -e
systemctl daemon-reload >/dev/null 2>&1 || true
if [ "$1" = purge ]; then
  echo "maxora-pos: your data stays in Docker volumes (maxora-pos_pg_data, maxora-pos_uploads_data, maxora-pos_state) and your settings and generated passwords in /etc/maxora-pos/maxora-pos.env, so a later reinstall picks up where you left off. To delete everything for good: sudo docker compose --project-name maxora-pos down -v ; sudo rm -rf /etc/maxora-pos" >&2
fi
exit 0
