[Unit]
Description=Maxora POS (Docker Compose)
Documentation=https://maxora.example.com/docs
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
TimeoutStartSec=900
ExecStart=/usr/bin/docker compose --project-name maxora-pos --env-file /etc/maxora-pos/maxora-pos.env -f /usr/lib/maxora-pos/docker-compose.yml up -d --remove-orphans
ExecStop=/usr/bin/docker compose --project-name maxora-pos --env-file /etc/maxora-pos/maxora-pos.env -f /usr/lib/maxora-pos/docker-compose.yml down

[Install]
WantedBy=multi-user.target
